{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/rules.mjs", "session-start", "${CLAUDE_PLUGIN_DATA}"]
          }
        ]
      }
    ]
  }
}
